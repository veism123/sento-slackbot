# --- Slack -------------------------------------------------------------------
# From api.slack.com/apps → your app.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# --- Midland -----------------------------------------------------------------
# The deployed Midland instance. The bot discovers the token endpoint from
# <MIDLAND_BASE_URL>/.well-known/oauth-authorization-server, so this is usually
# the only URL you need.
MIDLAND_BASE_URL=https://...
# Override only if discovery is unavailable or the MCP route is non-default.
# MIDLAND_MCP_URL=https://.../api/mcp
# MIDLAND_TOKEN_URL=https://.../api/oauth/token

# Machine-writer credential, minted by a Midland operator with
# `npm run credential:mint` in the Midland repo. One credential per bot, so you
# can revoke this one without touching any courier.
MIDLAND_CLIENT_ID=...
MIDLAND_CLIENT_SECRET=...

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Behaviour ---------------------------------------------------------------
PORT=3000
# true = read Midland and report what it WOULD write, without writing.
# Keep this on until you have watched it choose the right entity a few times.
DRY_RUN=true
