# --- Slack -------------------------------------------------------------------
# From api.slack.com/apps → your app.
# OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# Socket Mode. Basic Information → App-Level Tokens → Generate, with the
# connections:write scope. Setting this means the bot dials out to Slack and
# needs no public URL. Leave it out to run the HTTP events endpoint instead.
SLACK_APP_TOKEN=xapp-...

# HTTP mode only. Basic Information → Signing Secret. Not used in Socket Mode.
# SLACK_SIGNING_SECRET=...

# --- Sento -----------------------------------------------------------------
# The deployed Sento instance. The MCP endpoint defaults to
# <SENTO_BASE_URL>/api/mcp.
SENTO_BASE_URL=https://app.sentohq.com
# Override only if the MCP route is non-default.
# SENTO_MCP_URL=https://.../api/mcp

# The connection key from the workspace's Members panel ("Bot is connected"
# screen). Shown once at creation and not recoverable; if lost, revoke the
# connection and add another. It does not expire — it is sent as the
# Authorization bearer on every request, and a 401 means it was revoked.
# One connection per bot, so revoking this one touches nothing else.
SENTO_CONNECTION_KEY=...

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Behaviour ---------------------------------------------------------------
PORT=3000
# true = read Sento and report what it WOULD write, without writing.
# Keep this on until you have watched it choose the right entity a few times.
DRY_RUN=true
